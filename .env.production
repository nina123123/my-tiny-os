# Supabase, used by the live build for the guestbook.
#
# Empty for now: the guestbook says "opens soon" and keeps notes on each
# visitor's own device. To switch it on, use a Supabase project that belongs to
# this site alone (a publishable key works for every table in its project that
# lets visitors in, so don't reuse a project another site uses):
#   1. In the Supabase dashboard → New project.
#   2. SQL Editor → paste supabase/guestbook.sql → Run.
#   3. Fill in the two values below (or set them as repo Actions *Variables*,
#      see docs/GUESTBOOK.md) and push.
# The publishable key is public by design; row level security in
# supabase/guestbook.sql protects everything else.
# Never put the service_role / secret key or the database password here.

# Project Settings → Data API → Project URL
VITE_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_…)
VITE_SUPABASE_ANON_KEY=
# This site's own moderated table, created by supabase/guestbook.sql.
VITE_GUESTBOOK_TABLE=guestbook
