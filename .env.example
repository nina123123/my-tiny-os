# Environment variables
#
# Copy this file to .env.local (already git-ignored) and fill in the values, then
# restart `npm run dev`. Leave the first two empty and the guestbook keeps notes
# on the visitor's own device.
# Step-by-step setup: docs/GUESTBOOK.md
#
# These end up inside the public website, which is fine: the publishable/anon key
# is designed to be public, and Supabase's Row Level Security decides what it may do.
# NEVER put the service_role / secret key here.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API Keys → publishable key (sb_publishable_…) or legacy anon key (eyJ…)
VITE_SUPABASE_ANON_KEY=

# The moderated guestbook table created by supabase/guestbook.sql
VITE_GUESTBOOK_TABLE=guestbook
